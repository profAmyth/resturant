---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import CtaBand from '../components/CtaBand.astro';
import { GALLERY_CATEGORY_ORDER, GALLERY_CATEGORY_LABELS } from '../lib/constants';

const allPhotos = await getCollection('gallery');

const ordered = GALLERY_CATEGORY_ORDER.flatMap((category) =>
  allPhotos.filter((photo) => photo.data.category === category)
);

let runningIndex = 0;
const sections = GALLERY_CATEGORY_ORDER.map((category) => {
  const photos = allPhotos.filter((photo) => photo.data.category === category);
  const startIndex = runningIndex;
  runningIndex += photos.length;
  return { category, label: GALLERY_CATEGORY_LABELS[category], photos, startIndex };
}).filter((section) => section.photos.length > 0);
---

<BaseLayout title="Gallery" description="A look inside The Copper Fork — the dining room, the bar, the plates, and the people behind them.">
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-8 md:px-8 md:pt-24">
    <h1 class="text-4xl md:text-[56px]">A Taste of The Copper Fork</h1>
  </section>

  <div class="mx-auto max-w-7xl px-6 pb-16 md:px-8">
    {sections.map((section, sectionIndex) => (
      <section class="py-8">
        <h2 class="text-2xl md:text-[36px] mb-6">{section.label}</h2>
        <GalleryGrid
          startIndex={section.startIndex}
          eagerCount={sectionIndex === 0 ? 3 : 0}
          photos={section.photos.map((photo) => ({
            id: photo.id,
            src: photo.data.src,
            alt: photo.data.alt,
            category: photo.data.category,
            caption: photo.data.caption,
          }))}
        />
      </section>
    ))}
  </div>

  <CtaBand />

  <Lightbox photos={ordered.map((photo) => ({ src: photo.data.src, alt: photo.data.alt, caption: photo.data.caption }))} />
</BaseLayout>
