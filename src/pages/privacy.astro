---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy & Terms" description="Privacy policy and terms of use for The Copper Fork website.">
  <section class="mx-auto max-w-2xl px-6 py-16 md:px-8 md:py-24">
    <h1 class="text-4xl md:text-[56px]">Privacy Policy</h1>
    <div class="mt-6 space-y-4 text-charcoal/80">
      <p>
        This website is a portfolio demonstration for a fictional restaurant. It does not collect, store, or share
        personal data. The reservation widget on this site is simulated for demonstration purposes and does not
        transmit any information you enter.
      </p>
      <p>
        If this site were deployed for a real business, this page would be replaced with a privacy policy specific
        to that business's actual data practices.
      </p>
    </div>

    <h2 id="terms" class="mt-12 text-2xl md:text-[36px]">Terms of Use</h2>
    <div class="mt-6 space-y-4 text-charcoal/80">
      <p>
        The Copper Fork, its menu, staff, and location are entirely fictional and created for portfolio
        demonstration purposes. Any resemblance to a real restaurant is coincidental.
      </p>
      <p>
        Photography used throughout this site is licensed stock photography, credited in the site's gallery data
        where applicable, used under the Unsplash and Pexels licenses.
      </p>
    </div>
  </section>
</BaseLayout>
