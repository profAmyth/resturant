---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-6 py-24 text-center md:px-8 md:py-32">
    <p class="font-display text-4xl text-copper">404</p>
    <h1 class="mt-4 text-2xl md:text-[36px]">We couldn't find that page</h1>
    <p class="mt-3 text-charcoal/80">
      The page you're looking for may have moved or no longer exists. Let's get you back on track.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="inline-flex min-h-11 items-center rounded-lg bg-copper px-6 py-3 font-medium text-cream hover:bg-copper-dark transition-colors">
        Back to Home
      </a>
      <a href="/menu" class="inline-flex min-h-11 items-center rounded-lg border border-charcoal px-6 py-3 font-medium text-charcoal hover:bg-charcoal hover:text-cream transition-colors">
        View Menu
      </a>
    </div>
  </section>
</BaseLayout>
