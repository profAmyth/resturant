---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import HoursTable from '../components/HoursTable.astro';
import { restaurant, phoneHref } from '../lib/restaurant';
---

<BaseLayout title="Contact" description="Find The Copper Fork — address, hours, phone, and directions.">
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-8 md:px-8 md:pt-24">
    <h1 class="text-4xl md:text-[56px]">Visit Us</h1>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-16 md:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-xl font-display">Address</h2>
        <p class="mt-2 text-charcoal/80">
          {restaurant.address.street}<br />
          {restaurant.address.city}, {restaurant.address.state} {restaurant.address.zip}
        </p>
        <a
          href={restaurant.address.directionsUrl}
          class="btn-press mt-4 inline-flex min-h-11 items-center rounded-lg border border-charcoal px-6 py-3 font-medium text-charcoal hover:bg-charcoal hover:text-cream transition-colors"
        >
          Get Directions
        </a>

        <h2 class="mt-10 text-xl font-display">Contact</h2>
        <a href={phoneHref(restaurant.phone)} class="mt-2 block text-copper-dark hover:underline">{restaurant.phone}</a>
        <a href={`mailto:${restaurant.email}`} class="mt-1 block text-copper-dark hover:underline">{restaurant.email}</a>

        <h2 class="mt-10 text-xl font-display">Hours</h2>
        <div class="mt-2 max-w-xs">
          <HoursTable />
        </div>

        <h2 class="mt-10 text-xl font-display">Follow Along</h2>
        <div class="mt-3 flex gap-4">
          {restaurant.social.instagram && (
            <a href={restaurant.social.instagram} class="text-copper-dark hover:underline">Instagram</a>
          )}
          {restaurant.social.facebook && (
            <a href={restaurant.social.facebook} class="text-copper-dark hover:underline">Facebook</a>
          )}
        </div>
      </div>

      <div>
        <MapEmbed embedUrl={restaurant.address.mapEmbedUrl} title={`Map showing ${restaurant.name} location`} />
      </div>
    </div>
  </section>
</BaseLayout>
