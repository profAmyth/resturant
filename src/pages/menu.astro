---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuItemCard from '../components/MenuItemCard.astro';
import DietaryBadge from '../components/DietaryBadge.astro';
import CtaBand from '../components/CtaBand.astro';
import { CATEGORY_ORDER, CATEGORY_LABELS, DIETARY_LEGEND } from '../lib/constants';

const allItems = await getCollection('menu');
const available = allItems.filter((item) => item.data.available !== false);

const grouped = CATEGORY_ORDER.map((category) => ({
  category,
  label: CATEGORY_LABELS[category],
  items: available.filter((item) => item.data.category === category),
})).filter((group) => group.items.length > 0);
---

<BaseLayout title="Menu" description="The full Copper Fork menu — starters, salads, mains, handhelds, sides, desserts, and drinks, with dietary tags for every dish.">
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-8 md:px-8 md:pt-24">
    <h1 class="text-4xl md:text-[56px]">Menu</h1>
    <p class="mt-3 max-w-xl text-lg md:text-[20px] text-charcoal/80">Seasonal. Local. Shareable.</p>
  </section>

  <nav aria-label="Menu categories" class="sticky top-[65px] z-40 border-y border-stone/30 bg-cream/95 backdrop-blur">
    <ul class="mx-auto flex max-w-7xl gap-6 overflow-x-auto px-6 py-3 md:px-8">
      {grouped.map((group) => (
        <li class="shrink-0">
          <a href={`#${group.category}`} class="uppercase-label text-sm text-charcoal hover:text-copper transition-colors">
            {group.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mx-auto max-w-7xl px-6 py-12 md:px-8">
    {grouped.map((group, groupIndex) => (
      <section id={group.category} class="scroll-mt-32 py-8">
        <h2 class="text-2xl md:text-[36px] mb-6">{group.label}</h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {group.items.map((item, itemIndex) => (
            <MenuItemCard
              name={item.data.name}
              description={item.data.description}
              price={item.data.price}
              category={item.data.category}
              dietaryTags={item.data.dietaryTags}
              image={item.data.image}
              eager={groupIndex === 0 && itemIndex < 2}
            />
          ))}
        </div>
      </section>
    ))}

    <section class="mt-8 border-t border-stone/30 pt-8" aria-label="Dietary tag legend">
      <h2 class="uppercase-label text-sm text-charcoal/70">Dietary Legend</h2>
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm text-charcoal/80">
        {DIETARY_LEGEND.map((entry) => (
          <li class="flex items-center gap-1.5">
            <DietaryBadge tag={entry.code} />
            {entry.label}
          </li>
        ))}
        <li class="flex items-center gap-1.5">
          <DietaryBadge tag="spicy" />
          Spicy
        </li>
      </ul>
      <p class="mt-6 text-sm text-charcoal/70">Menu and prices subject to change.</p>
    </section>
  </div>

  <CtaBand />
</BaseLayout>
