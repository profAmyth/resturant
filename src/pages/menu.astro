---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuItemCard from '../components/MenuItemCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { CATEGORY_ORDER, CATEGORY_LABELS } from '../lib/constants';

const allItems = await getCollection('menu');
const available = allItems.filter((item) => item.data.available !== false);

const grouped = CATEGORY_ORDER.map((category) => ({
  category,
  label: CATEGORY_LABELS[category],
  items: available.filter((item) => item.data.category === category),
})).filter((group) => group.items.length > 0);
---

<BaseLayout title="Menu" description="The full Copper Fork menu — starters, salads, mains, handhelds, sides, desserts, and drinks, with dietary tags for every dish.">
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-8 md:px-8 md:pt-24">
    <h1 class="text-4xl md:text-[56px]">Menu</h1>
    <p class="mt-3 max-w-xl text-lg md:text-[20px] text-charcoal/80">Seasonal. Local. Shareable.</p>
  </section>

  <nav aria-label="Menu categories" class="sticky top-[65px] z-40 border-y border-stone/30 bg-cream/95 backdrop-blur">
    <ul class="mx-auto flex max-w-7xl gap-6 overflow-x-auto px-6 py-3 md:px-8">
      {grouped.map((group) => (
        <li class="shrink-0">
          <a href={`#${group.category}`} class="uppercase-label text-sm text-charcoal hover:text-copper transition-colors">
            {group.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mx-auto max-w-7xl px-6 py-12 md:px-8">
    {grouped.map((group) => (
      <section id={group.category} class="scroll-mt-32 py-8">
        <h2 class="text-2xl md:text-[36px] mb-6">{group.label}</h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {group.items.map((item) => (
            <MenuItemCard
              name={item.data.name}
              description={item.data.description}
              price={item.data.price}
              category={item.data.category}
              dietaryTags={item.data.dietaryTags}
              image={item.data.image}
            />
          ))}
        </div>
      </section>
    ))}

    <section class="mt-8 border-t border-stone/30 pt-8" aria-label="Dietary tag legend">
      <h2 class="uppercase-label text-sm text-stone">Dietary Legend</h2>
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm text-charcoal/80">
        <li><span class="mr-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full border border-sage px-1.5 text-xs text-sage">V</span> Vegetarian</li>
        <li><span class="mr-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-sage px-1.5 text-xs text-cream">VG</span> Vegan</li>
        <li><span class="mr-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full border border-amber px-1.5 text-xs text-amber">GF</span> Gluten-Free</li>
        <li><span class="mr-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full border border-stone px-1.5 text-xs text-stone">DF</span> Dairy-Free</li>
        <li><span class="mr-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full border border-charcoal/40 px-1.5 text-xs text-charcoal">NF</span> Nut-Free</li>
        <li class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-copper" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 8c-2 3-2 8 1 10.5 2 1.7 5 1.7 7 0 2.7-2.3 3-6.5 1-9.5" />
            <path d="M9 7c.5-2 2-4 4.5-4.5" />
          </svg>
          Spicy
        </li>
      </ul>
      <p class="mt-6 text-sm text-stone">Menu and prices subject to change.</p>
    </section>
  </div>

  <CtaBand />
</BaseLayout>
