---
import DietaryBadge from './DietaryBadge.astro';
import { thumbSrc } from '../lib/images';

interface Props {
  name: string;
  description: string;
  price: number;
  category: string;
  dietaryTags?: string[];
  image?: string;
  eager?: boolean;
}

const { name, description, price, category, dietaryTags = [], image, eager = false } = Astro.props;
const imageSrc = image ? thumbSrc(image) : `/images/menu/placeholder-${category}.svg`;
const imageAlt = image ? `${name}, plated` : '';
---

<article class="flex gap-4 rounded-xl border border-stone/30 bg-warm-white p-6">
  <img
    src={imageSrc}
    alt={imageAlt}
    width="96"
    height="96"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    class="h-24 w-24 shrink-0 rounded-lg object-cover photo-warm-grade"
  />
  <div class="flex-1">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-xl font-display">{name}</h3>
      <span class="shrink-0 font-medium text-copper-dark">${price}</span>
    </div>
    <p class="mt-1 text-sm text-charcoal/80">{description}</p>
    {dietaryTags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {dietaryTags.map((tag) => <DietaryBadge tag={tag as any} />)}
      </div>
    )}
  </div>
</article>
