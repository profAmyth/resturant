---
interface Props {
  heading?: string;
  body?: string;
}

const { heading = 'Ready to join us?', body = 'Tables fill up fast on weekends — reserve yours in a couple taps.' } = Astro.props;
---

<section class="bg-charcoal text-cream">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-6 py-16 text-center md:px-8 md:py-24">
    <h2 class="text-2xl md:text-[36px]">{heading}</h2>
    <p class="max-w-xl text-stone">{body}</p>
    <a
      href="/reservations"
      class="inline-flex min-h-11 items-center rounded-lg bg-copper px-8 py-3 font-medium text-cream hover:bg-copper-dark transition-colors"
    >
      Reserve a Table
    </a>
  </div>
</section>
