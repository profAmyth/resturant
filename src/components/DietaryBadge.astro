---
import { DIETARY_TAGS, type DietaryTag } from '../lib/constants';

interface Props {
  tag: DietaryTag;
}

const { tag } = Astro.props;
const { label, className } = DIETARY_TAGS[tag];
---

{tag === 'spicy' ? (
  <span class="inline-flex items-center" role="img" title="Spicy" aria-label="Spicy">
    <svg class="h-4 w-4 text-copper" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M8 8c-2 3-2 8 1 10.5 2 1.7 5 1.7 7 0 2.7-2.3 3-6.5 1-9.5" />
      <path d="M9 7c.5-2 2-4 4.5-4.5" />
    </svg>
  </span>
) : (
  <span class:list={['inline-flex h-5 min-w-5 items-center justify-center rounded-full px-1.5 text-xs font-medium', className]} title={label}>
    {label}
  </span>
)}
