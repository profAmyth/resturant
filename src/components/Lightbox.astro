---
import { X, ChevronLeft, ChevronRight } from '@lucide/astro';

interface Photo {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<dialog id="lightbox" class="m-auto max-h-none max-w-none overflow-hidden bg-transparent p-0 backdrop:bg-charcoal/95">
  <div id="lightbox-backdrop" class="relative flex h-screen w-screen items-center justify-center p-4">
    <button id="lightbox-close" type="button" class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-charcoal/60 text-cream hover:bg-charcoal" aria-label="Close">
      <X class="h-6 w-6" aria-hidden="true" />
    </button>
    <button id="lightbox-prev" type="button" class="absolute left-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-charcoal/60 text-cream hover:bg-charcoal md:left-4" aria-label="Previous photo">
      <ChevronLeft class="h-6 w-6" aria-hidden="true" />
    </button>
    <button id="lightbox-next" type="button" class="absolute right-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-charcoal/60 text-cream hover:bg-charcoal md:right-4" aria-label="Next photo">
      <ChevronRight class="h-6 w-6" aria-hidden="true" />
    </button>

    <figure class="flex max-h-full max-w-full flex-col items-center gap-3">
      <img id="lightbox-image" src="" alt="" class="max-h-[80vh] max-w-[90vw] rounded-lg object-contain photo-warm-grade" />
      <figcaption id="lightbox-caption" class="text-center text-cream/90"></figcaption>
    </figure>
  </div>
</dialog>

<script is:inline type="application/json" id="lightbox-data" set:html={JSON.stringify(photos)} />

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const image = document.getElementById('lightbox-image') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption') as HTMLElement;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const dataEl = document.getElementById('lightbox-data');

  const photos: { src: string; alt: string; caption?: string }[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  let currentIndex = 0;
  let lastTrigger: HTMLElement | null = null;

  function render(index: number) {
    const photo = photos[index];
    if (!photo) return;
    currentIndex = index;
    image.src = photo.src;
    image.alt = photo.alt;
    caption.textContent = photo.caption ?? '';
  }

  function open(index: number, trigger: HTMLElement) {
    lastTrigger = trigger;
    render(index);
    dialog.showModal();
  }

  function next() {
    render((currentIndex + 1) % photos.length);
  }

  function prev() {
    render((currentIndex - 1 + photos.length) % photos.length);
  }

  document.querySelectorAll('[data-lightbox-trigger]').forEach((el) => {
    el.addEventListener('click', () => {
      const index = Number((el as HTMLElement).dataset.index ?? 0);
      open(index, el as HTMLElement);
    });
  });

  closeBtn?.addEventListener('click', () => dialog.close());
  nextBtn?.addEventListener('click', next);
  prevBtn?.addEventListener('click', prev);

  const backdrop = document.getElementById('lightbox-backdrop');
  backdrop?.addEventListener('click', (event) => {
    if (event.target === backdrop) dialog.close();
  });

  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight') next();
    if (event.key === 'ArrowLeft') prev();
  });

  dialog.addEventListener('close', () => {
    lastTrigger?.focus();
  });

  let touchStartX = 0;
  dialog.addEventListener('touchstart', (event) => {
    touchStartX = event.changedTouches[0].clientX;
  });
  dialog.addEventListener('touchend', (event) => {
    const deltaX = event.changedTouches[0].clientX - touchStartX;
    if (Math.abs(deltaX) < 40) return;
    if (deltaX < 0) next();
    else prev();
  });
</script>
